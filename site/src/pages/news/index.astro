---
/**
 * «Новини» (ТЗ 4.8; решения 027, 031): тематическая лента «Новини галузі»
 * сторонних источников. Блока Facebook нет (ТЗ 4.7, решение 029).
 *
 * Ленты нет ни одной карточки — блок скрывается целиком, без заголовка
 * (ТЗ 4.8). Подпись блока — `news.feed.note` в `data/static-blocks.json`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedCards from '../../components/FeedCards.astro';
import { feed, hiddenFeedKeys, staticBlockText } from '../../gateway/data';
import { FEED_ITEMS_SHOWN, feedCards } from '../../domain/news';

const cards = feedCards(feed, FEED_ITEMS_SHOWN, hiddenFeedKeys);
const note = staticBlockText('news.feed.note');

const description =
  'Новини галузі: публікації про парки, сквери, озеленення й міські зелені зони з Києва, України та світу.';
---

{/* Лента — чужие публикации: вне индекса и после снятия закрытия (решение 039) */}
<BaseLayout section="Новини" path="/news/" description={description} indexable={false}>
  <h1>Новини</h1>

  {cards.length === 0 && <p class="lead">Новин поки немає.</p>}

  {cards.length > 0 && (
    <section class="section" aria-labelledby="news-feed">
      <h2 id="news-feed">Новини галузі</h2>
      {note && <p>{note.uk}</p>}
      <FeedCards cards={cards} />
    </section>
  )}
</BaseLayout>
