---
/**
 * «Наші закупівлі» (ТЗ 4.9): пояснение, карточки последних закупок из
 * синхронизации (версия 2) и прямые ссылки на Prozorro и Є-data.
 *
 * Карточки выводятся по правилу трёх состояний (ТЗ 3.3, 6.5): при ошибке
 * источника — прежние карточки с датой получения, без них — «Дані тимчасово
 * недоступні»; «пусто» при ошибке не показывается.
 *
 * Ссылок и текста в коде страницы нет (правило страницы 4.3): пояснение —
 * блок `tenders.note` в `data/static-blocks.json`, адреса — в
 * `data/public-docs.json`, те же записи, что и на «Публічній інформації».
 * С 19.11.2026 блока в данных нет (решение Заказчика, ТЗ 4.9): страница
 * открывается сразу карточками; пояснение возвращается одной записью данных.
 * Второй копии адресов не заводится: сменится адрес портала — правится
 * одна запись выгрузки, а не две страницы.
 *
 * Ссылка на Prozorro остаётся на странице и в версии 2: она не зависит
 * от синхронизации (ТЗ 4.9, «При отсутствии данных»).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicDocs, staticBlockText, tenders } from '../../gateway/data';
import { tenderLinks, PLACE_TAGS } from '../../domain/public-docs';
import { tendersView } from '../../domain/tenders';
import { withBase } from '../../config/site';

const note = staticBlockText('tenders.note');
const links = tenderLinks(publicDocs);
const view = tendersView(tenders);

const description =
  'Закупівлі КП УЗН Деснянського району: пошук у Prozorro за ЄДРПОУ 04589645, реєстри договорів і трансакцій підприємства на порталі Є-data.';
---

<BaseLayout section="Наші закупівлі" path="/tenders/" description={description}>
  <h1>Наші закупівлі</h1>

  {note && <p class="lead">{note.uk}</p>}

  <section class="section" aria-labelledby="tenders-latest">
    <h2 id="tenders-latest">Останні закупівлі</h2>
    {view.kind === 'unavailable' && <p>Дані тимчасово недоступні.</p>}
    {view.kind === 'empty' && <p>Закупівель поки немає.</p>}
    {view.kind === 'cards' && (
      <>
        {view.stale && (
          <p class="card__text">
            Дані отримано {view.stale}. Оновити їх зараз не вдалося — актуальний стан дивіться в
            Prozorro.
          </p>
        )}
        <ul class="grid grid--2 list-bare">
          {view.cards.map((card) => (
            <li class="card">
              <h3 class="card__title">
                <a class="ext" href={card.url} target="_blank" rel="noopener noreferrer">
                  {card.title}
                </a>
              </h3>
              <p class="card__text">
                <span class="tag">{card.status}</span>
              </p>
              <p class="card__text">
                Номер: {card.tenderID}
                <br />
                Оголошено: {card.published}
                {card.amount && (
                  <>
                    <br />
                    Очікувана вартість: {card.amount}
                  </>
                )}
                {card.deadline && (
                  <>
                    <br />
                    Подання пропозицій до: {card.deadline}
                  </>
                )}
              </p>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  {links.length > 0 && (
    <section class="section">
      <h2>Де дивитися закупівлі підприємства</h2>
      <ul class="grid grid--2 list-bare">
        {links.map((doc) => (
          <li class="card">
            <h3 class="card__title">
              <a class="ext" href={doc.externalUrl} target="_blank" rel="noopener noreferrer">
                {doc.title.uk}
              </a>
            </h3>
            <p class="card__text">
              <span class="tag">{PLACE_TAGS[doc.publishedWhere]}</span>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section">
    <h2>Інші документи підприємства</h2>
    <p>
      Фінансова звітність, оплата праці, статут і стратегічний план — на сторінці{' '}
      <a href={withBase('/about/public-info/')}>«Публічна інформація»</a>.
    </p>
  </section>
</BaseLayout>
