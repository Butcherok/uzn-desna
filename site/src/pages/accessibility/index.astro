---
/**
 * «Заява про доступність» (ТЗ 4.14, 11.3; решение 054; решения Заказчика
 * 26.11.2026). Статус — «частково відповідає»: проверка самостоятельная,
 * без экспертного аудита и без программ чтения с экрана (выбор Заказчика).
 * Названия настроек устройств даны словами самих настроек, без путей по
 * меню: пути меняются от версии к версии системы.
 *
 * Текст — только украинский: страница в составе английской версии 3 не
 * значится (ТЗ 4.13). Телефон и почта — из данных, как в подвале.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneInline from '../../components/PhoneInline.astro';
import { mailtoLinkHtml } from '@uzn/shared';
import { contacts, enterprise } from '../../gateway/data';
import { contactBySlug } from '../../domain/contacts';
import { A11Y_REVIEWED_AT, ENTERPRISE, withBase } from '../../config/site';

const office = contactBySlug(contacts, 'pryimalnia');
const KYIV = { timeZone: 'Europe/Kyiv' } as const;
const reviewed = new Date(`${A11Y_REVIEWED_AT}T12:00:00Z`).toLocaleDateString('uk-UA', KYIV);
const siteUrl = new URL(withBase('/'), Astro.site).href;

const description =
  'Наскільки сайт КП УЗН Деснянського району доступний людям з інвалідністю, що ще не перевірено, як збільшити текст і куди повідомити про проблему.';
---

<BaseLayout section="Заява про доступність" path="/accessibility/" description={description}>
  <h1>Заява про доступність</h1>

  <p>
    {ENTERPRISE.nameShort} прагне, щоб сайтом могли користуватися всі, зокрема люди з порушеннями
    зору, слуху, рухових і когнітивних функцій. Заява стосується сайту{' '}
    <a href={siteUrl}>{siteUrl}</a>.
  </p>

  <section class="section" aria-labelledby="a11y-status">
    <h2 id="a11y-status">Стан відповідності</h2>
    <p>
      Сайт <strong>частково відповідає</strong> настановам з доступності вебвмісту WCAG 2.2 рівня
      AA. «Частково» — бо перевірку ми провели самі, без незалежного аудиту, і частина вмісту від
      нас не залежить. Що саме — нижче.
    </p>
  </section>

  <section class="section" aria-labelledby="a11y-done">
    <h2 id="a11y-done">Що зроблено</h2>
    <ul>
      <li>
        Усім сайтом можна користуватися з клавіатури: фокус видно, перше посилання — «Перейти до
        вмісту».
      </li>
      <li>
        Контраст тексту — не нижчий за 4,5&nbsp;до&nbsp;1; межі кнопок і полів — не нижчі за
        3&nbsp;до&nbsp;1.
      </li>
      <li>Темна тема й підвищений контраст вмикаються самі — за налаштуваннями вашого пристрою.</li>
      <li>Текст можна збільшити до 400&nbsp;% без прокрутки сторінки вбік.</li>
      <li>На сторінках немає анімації, каруселі й автоматичного прокручування.</li>
      <li>
        Зображення мають текстовий опис, сторінки розмічено заголовками й орієнтирами для програм
        читання з екрана.
      </li>
      <li>
        Кнопки й телефони — не менші за 44&nbsp;на&nbsp;44&nbsp;пікселі; номер можна набрати одним
        дотиком.
      </li>
      <li>Публічні сторінки працюють з вимкненим JavaScript.</li>
    </ul>
  </section>

  <section class="section" aria-labelledby="a11y-limits">
    <h2 id="a11y-limits">Що може бути недоступним</h2>
    <ul>
      <li>
        Сайт не перевіряли з програмами читання з екрана (NVDA, JAWS, VoiceOver) і не проходив
        незалежного аудиту.
      </li>
      <li>
        Документи на інших сайтах, на які ведуть посилання (Prozorro, Є-data, сайти органів влади),
        ми не контролюємо: їхня доступність залежить від власників.
      </li>
      <li>
        Документи у форматі PDF, розміщені на сайті, можуть не мати структури для програм читання з
        екрана. Потрібен документ в іншому форматі — напишіть нам.
      </li>
      <li>
        «Новини» — публікації інших видань, частина з них англійською. Переклад — машинний, його
        якість ми не перевіряємо.
      </li>
      <li>Англійської версії сайту поки немає.</li>
    </ul>
  </section>

  <section class="section a11y-how" aria-labelledby="a11y-how">
    <h2 id="a11y-how">Як збільшити текст і ввімкнути контраст</h2>
    <h3>Збільшити сторінку</h3>
    <p>
      На комп'ютері — клавіші <kbd>Ctrl</kbd> і <kbd>+</kbd> (на Mac — <kbd>Cmd</kbd> і <kbd>+</kbd>
      ), повернути як було — <kbd>Ctrl</kbd> і <kbd>0</kbd>. На телефоні — розведіть два пальці на
      екрані.
    </p>
    <h3>Більший шрифт на всіх сайтах</h3>
    <p>
      У налаштуваннях браузера знайдіть «Розмір шрифту» або «Масштабування тексту». У Safari на
      iPhone — кнопка «аА» в рядку адреси.
    </p>
    <h3>Підвищений контраст і темна тема</h3>
    <p>
      Сайт підхоплює налаштування пристрою: на iPhone, iPad і Mac — «Збільшити контраст», у Windows
      — «Контрастні теми». Темна тема сайту вмикається разом із темною темою пристрою.
    </p>
  </section>

  <section class="section" aria-labelledby="a11y-feedback">
    <h2 id="a11y-feedback">Повідомити про проблему</h2>
    <p>
      Якщо щось на сайті вам недоступне або потрібна інформація в іншому форматі, напишіть або
      зателефонуйте нам. Укажіть сторінку й що саме не вдалося.
    </p>
    <ul class="list-bare">
      {enterprise.email && (
        <li>
          Пошта: <Fragment set:html={mailtoLinkHtml(enterprise.email)} />
        </li>
      )}
      {office && (
        <li>
          {office.purpose.uk}: <PhoneInline phone={office.phone} />
        </li>
      )}
    </ul>
  </section>

  <section class="section" aria-labelledby="a11y-method">
    <h2 id="a11y-method">Як складено цю заяву</h2>
    <p>
      Заяву складено <time datetime={A11Y_REVIEWED_AT}>{reviewed}</time> за результатами власної
      перевірки: автоматичної (axe-core, правила WCAG 2.0–2.2 рівнів A і AA) на всіх сторінках у
      світлій, темній і контрастній темах, на ширині екрана від 320 до 1920 пікселів і при
      збільшенні 200 та 400&nbsp;%, і ручного обходу з клавіатури. Заяву переглядаємо після значних
      змін сайту.
    </p>
  </section>
</BaseLayout>
