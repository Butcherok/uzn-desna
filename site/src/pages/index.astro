---
/**
 * «Головна» (ТЗ 4.1), версия 1, украинский. Состав первого экрана — вариант А
 * (дизайн-система, раздел 7а); растровый баннер и ночная картинка — решение 020.
 *
 * Блока цифр на главной нет (решение 018), абзаца-представления нет: его место
 * занимает лозунг (решение 019). Карточек разделов пять, пятая — «Новини»
 * (ТЗ 4.1, версия 2). Блок «Новини галузі» — три последние карточки ленты
 * (решение 027); ленты нет — блока нет.
 *
 * Первый экран переделан по замечаниям к версии 2 (решение 051): название и
 * девиз над баннером, баннер без панели, предметы выглядывают из-за него.
 *
 * Все сведения о предприятии — из данных, придуманного здесь нет
 * (инструкции проекта, п. 5).
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneLink from '../components/PhoneLink.astro';
import FeedCards from '../components/FeedCards.astro';
import { contacts, enterprise, feed, hiddenFeedKeys } from '../gateway/data';
import { FEED_ITEMS_ON_HOME, feedCards } from '../domain/news';
import { ASIDES, BANNER } from '../gateway/media';
import { contactBySlug } from '../domain/contacts';
import { organizationJsonLd } from '../domain/organization';
import { ENTERPRISE, NETWORK_LINKS, SITE_NAME, withBase } from '../config/site';
import { textLines } from '@uzn/shared';

/**
 * Ступени `srcset` баннера. Потолок 1600 — ТЗ 5.3, п. 2. Набор подобран под
 * семь проверяемых ширин (320–1920) в двух плотностях: замером в браузере
 * видно, что используется каждая ступень и ни на одной ширине не берётся
 * файл мельче нужного (решение 020).
 */
const BANNER_WIDTHS = [400, 600, 800, 1000, 1200, 1400, 1600];

/**
 * Коэффициенты 1,19 и 1,34 — поправка на обрезку. Баннер выводится с
 * `object-fit: cover` в трёх соотношениях (4:3, 3:2, 16:9), и на узких экранах
 * браузер показывает кусок кадра уже самого кадра. Без поправки он брал бы
 * ступень мельче, чем нужно для плотности 2 (ТЗ 11.2, п. 1).
 */
const BANNER_SIZES = [
  '(min-width: 1248px) 1152px',
  '(min-width: 1024px) calc(100vw - 48px)',
  '(min-width: 600px) calc((100vw - 48px) * 1.19)',
  'calc((100vw - 32px) * 1.34)',
].join(', ');

const bannerDay = await getImage({
  src: BANNER.day,
  widths: BANNER_WIDTHS,
  sizes: BANNER_SIZES,
  format: 'webp',
});
const bannerNight = await getImage({
  src: BANNER.night,
  widths: BANNER_WIDTHS,
  sizes: BANNER_SIZES,
  format: 'webp',
});

/** Боковые предметы: один размер 330 px — плотность 2 при выводе в 165 px. */
const asideBin = await getImage({ src: ASIDES.bin, width: 330, format: 'webp' });
const asidePlanter = await getImage({ src: ASIDES.planter, width: 330, format: 'webp' });
const asidePlants = await getImage({ src: ASIDES.plants, width: 330, format: 'webp' });

/**
 * С какой ширины окна выводится каждый предмет. Те же пороги стоят в
 * `components.css` (первый экран главной): там — размер и место, здесь —
 * загрузка файла. Уже 1280 px видимая часть предмета в поле страницы не
 * помещается, и файл не скачивается вовсе (дизайн-система 7а).
 */
const ASIDE_MEDIA = {
  bin: '(min-width: 1280px)',
  planter: '(min-width: 1280px)',
  plants: '(min-width: 1700px)',
} as const;

/**
 * Пустая картинка-заместитель для `<img>` внутри `<picture>` боковых предметов.
 * Ниже 1280 px ни один `<source>` не подходит, и браузер берёт этот адрес —
 * `data:` сетевого запроса не делает. Обычный `<img>` с настоящим файлом
 * скачивался бы и при `display: none`, а предметы на телефоне не выводятся
 * (дизайн-система 7а). Адрес `data:` разрешён политикой содержимого
 * (`img-src 'self' data:`, оболочка страниц).
 */
const BLANK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E";

const office = contactBySlug(contacts, 'pryimalnia');

const news = feedCards(feed, FEED_ITEMS_ON_HOME, hiddenFeedKeys);

/**
 * Карточки разделов (ТЗ 4.1). Четыре карточки: одна колонка, с 600 px —
 * две, с 1024 px — четыре в ряд (решение 052).
 */
const SECTIONS = [
  {
    path: '/services/',
    title: 'Послуги',
    text: 'Озеленення, догляд за насадженнями, ландшафтні роботи, вирощування розсади.',
  },
  {
    path: '/contacts/',
    title: 'Контакти',
    text: 'Адреса, графік роботи й телефони підрозділів підприємства.',
  },
  {
    path: '/about/',
    title: 'Про підприємство',
    text: 'Чим займається підприємство, керівництво, реквізити та публічна інформація.',
  },
  {
    path: '/news/',
    title: 'Новини',
    text: 'Новини галузі: парки, сквери й озеленення в Києві, Україні та світі.',
  },
] as const;

/**
 * Разметка организации — только на главной (Google: главная или «про нас»,
 * не на каждой странице). Чинна сторінка в `sameAs`: это то же предприятие
 * (решение 039).
 */
const homeUrl = new URL(withBase('/'), Astro.site).href;
const organization = organizationJsonLd({
  enterprise,
  office,
  name: SITE_NAME,
  url: homeUrl,
  logoUrl: new URL(withBase('/logo-512.png'), Astro.site).href,
  sameAs: [ENTERPRISE.facebook, NETWORK_LINKS[1].href],
  ...ENTERPRISE.postalAddress,
});

const description =
  'КП УЗН Деснянського району: озеленення й догляд за зеленими насадженнями району. Послуги, контакти, новини.';
---

<BaseLayout
  section="Головна"
  path="/"
  title={`${SITE_NAME} — озеленення й догляд`}
  description={description}
  jsonLd={organization}
>
  {/* Первый экран (ТЗ 4.1, дизайн-система 7а, правка 26.11.2026): название и
      девиз — над рисунком, на фоне страницы: контраст текста не зависит от
      рисунка (ТЗ 11.3, п. 1). Кнопки нет — «Контакти» есть в шапке и подвале.
      Девиз — подзаголовок, не заголовок: заголовок на странице один */}
  <section class="hero" aria-labelledby="home-title">
    <div class="hero__head">
      <h1 id="home-title" class="hero__title">
        {ENTERPRISE.nameShort}
      </h1>
      <p class="hero__slogan">Озеленення й догляд — наша щоденна робота</p>
    </div>

    <div class="hero__media">
      {/* Предмети виглядають з-за малюнка: декоративні, від 1280 px, там, де
          їх видима частина вміщується в поле сторінки (дизайн-система 7а).
          Стоять у розмітці перед малюнком — малюнок над ними за шарами */}
      <div class="hero__props" aria-hidden="true">
        <picture>
          <source media={ASIDE_MEDIA.bin} type="image/webp" srcset={asideBin.src} />
          <img class="hero__aside hero__aside--bin" src={BLANK} alt="" width="330" height="480" />
        </picture>
        <picture>
          <source media={ASIDE_MEDIA.planter} type="image/webp" srcset={asidePlanter.src} />
          <img
            class="hero__aside hero__aside--planter"
            src={BLANK}
            alt=""
            width="330"
            height="480"
          />
        </picture>
        <picture>
          <source media={ASIDE_MEDIA.plants} type="image/webp" srcset={asidePlants.src} />
          <img
            class="hero__aside hero__aside--plants"
            src={BLANK}
            alt=""
            width="330"
            height="480"
          />
        </picture>
      </div>

      <picture>
        <source
          media="(prefers-color-scheme: dark)"
          type="image/webp"
          srcset={bannerNight.srcSet.attribute}
          sizes={BANNER_SIZES}
        />
        <img
          class="hero__pic"
          src={bannerDay.src}
          srcset={bannerDay.srcSet.attribute}
          sizes={BANNER_SIZES}
          alt="Парк Деснянського району: алеї з лавками й ліхтарями між деревами ведуть до будівлі районної адміністрації та кінотеатру, позаду житлові багатоповерхівки, біля кінотеатру люди"
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  {/* Заголовка у блока нет: на странице он был бы вторым подряд и ничего не
      добавлял бы к названиям карточек. Название блока получает сам раздел —
      им пользуется навигация с экранного диктора (ТЗ 11.3) */}
  <section class="section" aria-label="Розділи сайту">
    <div class="grid grid--4">
      {SECTIONS.map((item) => (
        <a class="card card--link" href={withBase(item.path)}>
          <span class="card__title">{item.title}</span>
          <span class="card__text">{item.text}</span>
        </a>
      ))}
    </div>
  </section>

  {news.length > 0 && (
    <section class="section" aria-labelledby="home-news">
      <h2 id="home-news">Новини галузі</h2>
      <FeedCards cards={news} />
      <p class="mt-2">
        Усі новини — на сторінці <a href={withBase('/news/')}>Новини</a>.
      </p>
    </section>
  )}

  <section class="section">
    <h2>Контакти</h2>
    <div class="card">
      <ul class="list-bare">
        <li>{ENTERPRISE.address}</li>
        {textLines(office?.hours?.uk).map((line) => (
          <li>{line}</li>
        ))}
      </ul>
      {office && <PhoneLink phone={office.phone} hint={office.purpose.uk} />}
      <p class="mt-2">
        Усі телефони підрозділів — на сторінці <a href={withBase('/contacts/')}>Контакти</a>.
      </p>
    </div>
  </section>
</BaseLayout>
