---
/**
 * «Контакти» (ТЗ 4.6). Состав блоков — утверждённый контент
 * `claude/12_kontent-4-5-4-6.md`, версия 0.3, раздел 4.
 *
 * Телефоны и часы — данные `data/contacts.json`, почта — `data/enterprise.json`.
 * Непроверенный телефон не выводится, нет почты — блок почты скрывается
 * (ТЗ 4.6). Почта собрана HTML-сущностями: простого текстового `mailto:`
 * в исходном коде страницы нет (ТЗ 5.4, п. 7; решение 008).
 *
 * Встроенной карты нет, блока приёма граждан нет, форм ввода нет (ТЗ 4.6, 1.2).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ContactRow } from '../../components/cards/ContactRow';
import { renderStatic } from '../../components/cards/render-static';
import { mailtoLinkHtml } from '@uzn/shared';
import { contacts, enterprise } from '../../gateway/data';
import { contactBySlug, publishedContacts } from '../../domain/contacts';
import { ENTERPRISE, withBase } from '../../config/site';

const phones = publishedContacts(contacts);
const office = contactBySlug(contacts, 'pryimalnia');
const duty = contactBySlug(contacts, 'operatyvnyi-cherhovyi');

const description =
  'Адреса, телефони та графік роботи КП УЗН Деснянського району: приймальня, бухгалтерія, відділ кадрів, оперативний черговий. Як дістатися та сторінка у Facebook.';
---

<BaseLayout section="Контакти" path="/contacts/" description={description}>
  <h1>Контакти</h1>

  <div class="card">
    <p class="card__title">{ENTERPRISE.nameShort}</p>
    <ul class="list-bare">
      <li>{ENTERPRISE.address}</li>
      <li>ЄДРПОУ {ENTERPRISE.edrpou}</li>
      {office?.hours && <li>{office.hours.uk}</li>}
      <li>Сб, Нд — вихідні</li>
      {duty && <li>Оперативний черговий приймає звернення цілодобово.</li>}
    </ul>
  </div>

  {phones.length > 0 && (
    <section class="section">
      <table class="specs">
        <tbody>
          {phones.map((contact) => (
            <Fragment
              set:html={renderStatic(ContactRow, {
                purpose: contact.purpose.uk,
                phone: contact.phone,
                hours: contact.hours?.uk,
              })}
            />
          ))}
        </tbody>
      </table>

      {duty && (
        <p class="mt-6">
          Якщо впало дерево, не политі насадження або зламана лавка — телефонуйте оперативному
          черговому. Перелік ситуацій — на сторінці{' '}
          <a href={withBase('/where-to-ask/')}>Куди звертатися</a>.
        </p>
      )}
    </section>
  )}

  {enterprise.email && (
    <section class="section">
      <h2>Електронна пошта</h2>
      <p>
        <strong>
          <Fragment set:html={mailtoLinkHtml(enterprise.email)} />
        </strong>{' '}
        — для звернень і запитів на інформацію.
      </p>
    </section>
  )}

  <section class="section">
    <h2>Як дістатися</h2>
    <p>Адреса: {ENTERPRISE.address}.</p>
    <p>
      <a class="ext" href={ENTERPRISE.mapsUrl} target="_blank" rel="noopener noreferrer">
        Показати на карті Google
      </a>{' '}
      (відкриється в новій вкладці)
    </p>
  </section>

  <p>
    <a class="ext" href={ENTERPRISE.facebook} target="_blank" rel="noopener noreferrer">
      Сторінка підприємства у Facebook
    </a>{' '}
    (відкриється в новій вкладці)
  </p>
</BaseLayout>
