---
/**
 * «Про підприємство» (ТЗ 4.2). Состав блоков — решение Заказчика 17.11.2026:
 * описание деятельности, история, реквизиты, руководство, ссылки на
 * подразделы. Блока структуры предприятия нет (решение 011).
 *
 * Все сведения — данные `data/enterprise.json` и `data/leaders.json`;
 * придуманных сведений о предприятии в коде страницы нет (инструкции
 * проекта, п. 5). Нет текста — блок скрывается, пустых заголовков нет
 * (ТЗ 3.3, 4.2).
 *
 * Биография раскрывается элементом `details` — без JavaScript
 * (ТЗ 11.7, п. 4; дизайн-система, раздел 7).
 *
 * «У цифрах» и «Що доглядаємо» (решение 053): численность и площади —
 * поля `staffCount` и `areas`. Итог площади — сумма строк таблицы, в данных
 * его нет, поэтому строки и итог на странице сходятся всегда (решение 018).
 * От 1024 px текст и «У цифрах» стоят рядом; ниже — друг под другом.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  LeaderCard,
  type LeaderCardProps,
  type LeaderPhoto,
} from '../../components/cards/LeaderCard';
import { renderStatic } from '../../components/cards/render-static';
import {
  formatCount,
  formatDate,
  formatHectaresExact,
  formatHectaresShort,
  totalHectares,
} from '@uzn/shared';
import { enterprise, leaders, staticBlockText } from '../../gateway/data';
import { leaderPhoto } from '../../gateway/media';
import { publishedLeaders } from '../../domain/leaders';
import { RichText } from '../../components/cards/RichText';
import { withBase } from '../../config/site';

const summary = enterprise.infoReference?.uk.trim() ?? '';
const areas = enterprise.areas ?? [];
const total = totalHectares(areas);
const facts: { value: string; label: string }[] = [
  ...(enterprise.staffCount
    ? [{ value: formatCount(enterprise.staffCount), label: 'Працівники' }]
    : []),
  ...(areas.length > 0
    ? [{ value: formatHectaresShort(total), label: 'Площа під доглядом, га' }]
    : []),
  ...areas
    .filter((a) => a.inSummary && a.count)
    .map((a) => ({ value: formatCount(a.count ?? 0), label: a.name.uk })),
];
const historyBlock = staticBlockText('about.history');
const history = historyBlock?.uk.trim() ?? '';
// Фото — WebP 88 px с плотностями 1 и 2, нарезанные сборкой (ТЗ 5.3); фото
// без описания не выводится (ТЗ 11.3).
const cards: LeaderCardProps[] = await Promise.all(
  publishedLeaders(leaders).map(async (leader) => {
    let photo: LeaderPhoto | undefined;
    if (leader.photoPath && leader.photoAlt) {
      const image = await getImage({
        src: leaderPhoto(leader.photoPath),
        width: 88,
        height: 88,
        densities: [1, 2],
        format: 'webp',
      });
      photo = { src: image.src, srcSet: image.srcSet.attribute, alt: leader.photoAlt.uk };
    }
    return {
      fullName: leader.fullName.uk,
      position: leader.position.uk,
      since: leader.since,
      bio: leader.bio?.uk,
      photo,
    };
  }),
);

const description =
  'КП УЗН Деснянського району: чим займається підприємство, реквізити, правова основа та керівництво підприємства.';
---

<BaseLayout section="Про підприємство" path="/about/" description={description}>
  <h1>Про підприємство</h1>

  {(summary || facts.length > 0 || areas.length > 0) && (
    <section class="section" aria-labelledby="about-what">
      <h2 id="about-what">Чим займається підприємство</h2>
      <div class={summary && facts.length > 0 ? 'about-split' : undefined}>
        {summary && (
          <div>
            <Fragment
              set:html={renderStatic(RichText, { text: summary, firstClassName: 'lead' })}
            />
          </div>
        )}
        {facts.length > 0 && (
          <aside class="card facts" aria-labelledby="about-facts">
            <h3 id="about-facts" class="facts__title">
              У цифрах
            </h3>
            <ul class="nums nums--2 list-bare">
              {facts.map((f) => (
                <li class="num">
                  <span class="num__v">{f.value}</span>
                  <span class="num__l">{f.label}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
      {areas.length > 0 && (
        <>
          <h3 id="about-areas">Що доглядаємо</h3>
          <table class="figures" aria-labelledby="about-areas">
            <thead>
              <tr>
                <th scope="col">Категорія</th>
                <th scope="col" class="figures__n">
                  Кількість
                </th>
                <th scope="col" class="figures__n">
                  Площа, га
                </th>
              </tr>
            </thead>
            <tbody>
              {areas.map((a) => (
                <tr>
                  <th scope="row">{a.name.uk}</th>
                  <td class="figures__n">
                    {a.count ? (
                      formatCount(a.count)
                    ) : (
                      <>
                        <span aria-hidden="true">—</span>
                        <span class="vh">немає даних</span>
                      </>
                    )}
                  </td>
                  <td class="figures__n">{formatHectaresExact(a.hectares)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Разом</th>
                <td class="figures__n" />
                <td class="figures__n">{formatHectaresExact(total)}</td>
              </tr>
            </tfoot>
          </table>
        </>
      )}
    </section>
  )}

  {history && (
    <section class="section">
      <h2>Історія підприємства</h2>
      <Fragment set:html={renderStatic(RichText, { text: history })} />
    </section>
  )}

  <section class="section">
    <h2>Реквізити</h2>
    <table class="specs">
      <tbody>
        <tr>
          <th scope="row">Повна назва</th>
          <td>{enterprise.nameFull.uk}</td>
        </tr>
        <tr>
          <th scope="row">Код ЄДРПОУ</th>
          <td>{enterprise.edrpou}</td>
        </tr>
        <tr>
          <th scope="row">Організаційно-правова форма</th>
          <td>{enterprise.legalForm.uk}</td>
        </tr>
        {enterprise.registeredAt && (
          <tr>
            <th scope="row">Дата реєстрації</th>
            <td>{formatDate(enterprise.registeredAt)}</td>
          </tr>
        )}
        <tr>
          <th scope="row">Власник</th>
          <td>{enterprise.ownerBody.uk}</td>
        </tr>
        <tr>
          <th scope="row">Підпорядкування</th>
          <td>{enterprise.governedBy.uk}</td>
        </tr>
        {enterprise.coordinatedBy && (
          <tr>
            <th scope="row">Координуючий орган</th>
            <td>{enterprise.coordinatedBy.uk}</td>
          </tr>
        )}
        {enterprise.kved && enterprise.kved.length > 0 && (
          <tr>
            <th scope="row">Види діяльності (КВЕД)</th>
            <td>
              <ul class="list-bare">
                {enterprise.kved.map((kved) => (
                  <li>
                    {kved.code} — {kved.title.uk}
                  </li>
                ))}
              </ul>
            </td>
          </tr>
        )}
      </tbody>
    </table>

    {enterprise.legalBasis && enterprise.legalBasis.length > 0 && (
      <>
        <h3>Правова основа</h3>
        <ul class="list-bare">
          {enterprise.legalBasis.map((item) => (
            <li>{item.uk}</li>
          ))}
        </ul>
      </>
    )}
  </section>

  {cards.length > 0 && (
    <section class="section">
      <h2>Керівництво</h2>
      <div class="grid grid--2">
        {cards.map((card) => (
          <Fragment set:html={renderStatic(LeaderCard, card)} />
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <h2>Докладніше</h2>
    <ul class="list-bare">
      <li>
        <a href={withBase('/about/public-info/')}>Публічна інформація</a> — документи підприємства
        та перелік відомостей, які оприлюднюються за законом.
      </li>
      <li>
        <a href={withBase('/tenders/')}>Наші закупівлі</a> — закупівлі підприємства в системі
        Prozorro.
      </li>
      <li>
        <a href={withBase('/jobs/')}>Вакансії</a> — відкриті вакансії і телефон відділу кадрів.
      </li>
    </ul>
  </section>
</BaseLayout>
