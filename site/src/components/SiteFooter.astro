---
/**
 * Подвал на всех страницах (ТЗ 3.1, подвал): реквизиты и телефоны с признаком
 * «Показувати в підвалі» (в данных — приймальня), «Підприємства мережі»,
 * Facebook; нижняя полоса — © предприятия, дата обновления, ссылка на
 * «Заяву про доступність» (решение 054) и разработчик (решение 050). Колонки дежурного нет: оперативний черговий — только на
 * «Контактах» (решение 052).
 *
 * Телефоны и почта приходят параметрами: слой components выводит переданные
 * данные и сам к файлам не обращается (ТЗ 10.2). Почта собрана числовыми
 * HTML-сущностями: простого текстового `mailto:` в исходном коде страницы
 * нет (ТЗ 3.1, подвал, п. 1; ТЗ 5.4, п. 7; решение 008).
 */
import type { Contact } from '@uzn/shared';
import { mailtoLinkHtml, textLines } from '@uzn/shared';
import PhoneLink from './PhoneLink.astro';
import { ENTERPRISE, NETWORK_LINKS, withBase } from '../config/site';
import { INTL_LOCALE, type Lang } from '../i18n/lang';
import { UI } from '../i18n/ui';

interface Props {
  /** Точки с признаком `showInFooter`, уже отобранные и отсортированные */
  contacts: readonly Contact[];
  /** Почта предприятия из данных; нет почты — строка скрывается */
  email?: string | undefined;
  /** Время последней правки содержимого, ISO 8601 (`contentUpdatedAt`) */
  updatedAt: string;
  /**
   * Язык подвала (решение 056). Тексты данных — на языке страницы: английская
   * страница собирается только при переводе текстов подвала (domain/translation).
   * Внешние сайты и «Заява про доступність» — украинские: у ссылок `hreflang="uk"`.
   */
  lang?: Lang;
}

const { contacts, email, updatedAt, lang = 'uk' } = Astro.props;
const ui = UI[lang];
const t = (text: { uk: string; en?: string | undefined } | undefined): string | undefined =>
  lang === 'uk' ? text?.uk : text?.en;
/** На английской странице ссылка на украинскую страницу или сайт помечается `hreflang` */
const ukHref = lang === 'uk' ? undefined : 'uk';

/** Часы предприятия — у первой точки подвала (приймальня). */
const office = contacts[0];
/** Даты — по киевскому времени: сборка идёт на сервере в UTC. */
const KYIV = { timeZone: 'Europe/Kyiv' } as const;
const updated = new Date(updatedAt).toLocaleDateString(INTL_LOCALE[lang], KYIV);
const updatedIso = new Date(updatedAt).toLocaleDateString('sv-SE', KYIV);
const year = new Intl.DateTimeFormat('en', { ...KYIV, year: 'numeric' }).format(new Date());
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <section>
      <h2>{ui.nameShort}</h2>
      <ul class="list-bare">
        <li>
          {ui.edrpou} {ENTERPRISE.edrpou}
        </li>
        <li>{ui.address}</li>
        {textLines(t(office?.hours)).map((line) => (
          <li>{line}</li>
        ))}
      </ul>
      {contacts.map((contact) => (
        <>
          <p class="mt-2">{t(contact.purpose)}</p>
          <PhoneLink phone={contact.phone} />
        </>
      ))}
      {email && (
        <p class="mt-2">
          <Fragment set:html={mailtoLinkHtml(email)} />
        </p>
      )}
    </section>

    <section>
      <h2>{ui.footer.networkTitle}</h2>
      <ul class="list-bare">
        {NETWORK_LINKS.map((link, i) => (
          <li>
            <a
              class="ext"
              href={link.href}
              hreflang={ukHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {ui.footer.networkLinks[i]}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>{ui.footer.facebookTitle}</h2>
      <p>
        <a
          class="ext"
          href={ENTERPRISE.facebook}
          hreflang={ukHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {ui.footer.facebookLink}
        </a>
      </p>
    </section>
  </div>

  <div class="container">
    <div class="site-footer__bar">
      <p>
        © {year} {ui.nameShort}. {ui.footer.rights}
      </p>
      <p>
        {ui.footer.updated} <time datetime={updatedIso}>{updated}</time>
      </p>
      <p>
        <a href={withBase('/accessibility/')} hreflang={ukHref}>
          {ui.footer.accessibility}
        </a>
      </p>
      <p>{ui.footer.developer}</p>
    </div>
  </div>
</footer>
