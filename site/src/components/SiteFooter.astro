---
/**
 * Подвал на всех страницах (ТЗ 3.1, подвал): реквизиты и телефон приймальні,
 * ссылка «Куди звертатися» с телефоном оперативного дежурного, «Підприємства
 * мережі», Facebook, дата обновления.
 *
 * Телефоны приходят параметром: слой components выводит переданные данные и
 * сам к файлам не обращается (ТЗ 10.2). Блока почты в подвале нет — ТЗ 3.1
 * его не предусматривает.
 */
import type { Contact } from '@uzn/shared';
import PhoneLink from './PhoneLink.astro';
import { CONTENT_UPDATED_AT, ENTERPRISE, NETWORK_LINKS, withBase } from '../config/site';

interface Props {
  /** Точки с признаком `showInFooter`, уже отобранные и отсортированные */
  contacts: readonly Contact[];
}

const { contacts } = Astro.props;

const office = contacts.find((contact) => !contact.roundClock);
const duty = contacts.find((contact) => contact.roundClock);
const updated = new Date(CONTENT_UPDATED_AT).toLocaleDateString('uk-UA');
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <section>
      <h2>{ENTERPRISE.nameShort}</h2>
      <ul class="list-bare">
        <li>ЄДРПОУ {ENTERPRISE.edrpou}</li>
        <li>{ENTERPRISE.address}</li>
        {office?.hours && <li>{office.hours.uk}</li>}
      </ul>
      {office && <p class="mt-2">{office.purpose.uk}</p>}
      {office && <PhoneLink phone={office.phone} />}
    </section>

    <section>
      <h2>
        <a href={withBase('/where-to-ask/')}>Куди звертатися</a>
      </h2>
      {duty && <p>{duty.purpose.uk}</p>}
      {duty && <PhoneLink phone={duty.phone} hint={duty.hours?.uk} />}
    </section>

    <section>
      <h2>Підприємства мережі</h2>
      <ul class="list-bare">
        {NETWORK_LINKS.map((link) => (
          <li>
            <a class="ext" href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Facebook</h2>
      <p>
        <a class="ext" href={ENTERPRISE.facebook} target="_blank" rel="noopener noreferrer">
          Сторінка підприємства
        </a>
      </p>
    </section>
  </div>

  <p class="container site-footer__note">Інформація оновлена: {updated}</p>
</footer>
