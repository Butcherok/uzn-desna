---
/**
 * Подвал на всех страницах (ТЗ 3.1, подвал): реквизиты и телефон приймальні,
 * ссылка «Куди звертатися» с телефоном оперативного дежурного, «Підприємства
 * мережі», Facebook; нижняя полоса — © предприятия, дата обновления и
 * разработчик (решение 050).
 *
 * Телефоны и почта приходят параметрами: слой components выводит переданные
 * данные и сам к файлам не обращается (ТЗ 10.2). Почта собрана числовыми
 * HTML-сущностями: простого текстового `mailto:` в исходном коде страницы
 * нет (ТЗ 3.1, подвал, п. 1; ТЗ 5.4, п. 7; решение 008).
 */
import type { Contact } from '@uzn/shared';
import { mailtoLinkHtml, textLines } from '@uzn/shared';
import PhoneLink from './PhoneLink.astro';
import { ENTERPRISE, NETWORK_LINKS, withBase } from '../config/site';

interface Props {
  /** Точки с признаком `showInFooter`, уже отобранные и отсортированные */
  contacts: readonly Contact[];
  /** Почта предприятия из данных; нет почты — строка скрывается */
  email?: string | undefined;
  /** Время последней правки содержимого, ISO 8601 (`contentUpdatedAt`) */
  updatedAt: string;
}

const { contacts, email, updatedAt } = Astro.props;

const office = contacts.find((contact) => !contact.roundClock);
const duty = contacts.find((contact) => contact.roundClock);
/** Даты — по киевскому времени: сборка идёт на сервере в UTC. */
const KYIV = { timeZone: 'Europe/Kyiv' } as const;
const updated = new Date(updatedAt).toLocaleDateString('uk-UA', KYIV);
const updatedIso = new Date(updatedAt).toLocaleDateString('sv-SE', KYIV);
const year = new Intl.DateTimeFormat('en', { ...KYIV, year: 'numeric' }).format(new Date());
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <section>
      <h2>{ENTERPRISE.nameShort}</h2>
      <ul class="list-bare">
        <li>ЄДРПОУ {ENTERPRISE.edrpou}</li>
        <li>{ENTERPRISE.address}</li>
        {textLines(office?.hours?.uk).map((line) => (
          <li>{line}</li>
        ))}
      </ul>
      {office && <p class="mt-2">{office.purpose.uk}</p>}
      {office && <PhoneLink phone={office.phone} />}
      {email && (
        <p class="mt-2">
          <Fragment set:html={mailtoLinkHtml(email)} />
        </p>
      )}
    </section>

    <section>
      <h2>
        <a href={withBase('/where-to-ask/')}>Куди звертатися</a>
      </h2>
      {duty && <p>{duty.purpose.uk}</p>}
      {duty && <PhoneLink phone={duty.phone} hint={duty.hours?.uk} />}
    </section>

    <section>
      <h2>Підприємства мережі</h2>
      <ul class="list-bare">
        {NETWORK_LINKS.map((link) => (
          <li>
            <a class="ext" href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Facebook</h2>
      <p>
        <a class="ext" href={ENTERPRISE.facebook} target="_blank" rel="noopener noreferrer">
          Сторінка підприємства
        </a>
      </p>
    </section>
  </div>

  <div class="container">
    <div class="site-footer__bar">
      <p>
        © {year} {ENTERPRISE.nameShort}. Усі права захищено.
      </p>
      <p>
        Оновлено <time datetime={updatedIso}>{updated}</time>
      </p>
      <p>Розробка — S#RP</p>
    </div>
  </div>
</footer>
