---
/**
 * Шапка и верхнее меню (ТЗ 3.1). Меню построено на кнопке и `popover`:
 * работает с выключенным JavaScript, открытое меню лежит в верхнем слое
 * браузера и шапку не раздвигает, Esc и повторное нажатие кнопки его
 * закрывают, связь кнопки и панели (`aria-expanded`) браузер делает сам —
 * поэтому `aria-expanded` руками не ставится (ТЗ 11.7, п. 4; решение 010).
 * Знак предприятия — «дерево в колі», форма Д4 (ТЗ 5.3, п. 6; решения 015 и 016).
 * Крона — три доли плюс прямоугольник между ними: ровный круг на стволе
 * читается как лампочка, неровный край кроны это снимает (решение 016).
 * Значок вкладки `site/public/favicon.svg` — тот же рисунок, форма Д2:
 * увеличен в 16/15, круг там занимает весь квадрат. Правки держать парой.
 */
import { ENTERPRISE, NAV, withBase } from '../config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (path: string): boolean => path === currentPath;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href={withBase('/')} aria-label={`${ENTERPRISE.nameShort}, головна`}>
      <svg
        class="brand__mark"
        width="32"
        height="32"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <clipPath id="brand-mark-disc">
            <circle cx="16" cy="16" r="15"></circle>
          </clipPath>
        </defs>
        <circle class="brand__disc" cx="16" cy="16" r="15"></circle>
        <circle class="brand__crown" cx="10.6" cy="16.2" r="5.9"></circle>
        <circle class="brand__crown" cx="21.4" cy="16.2" r="5.9"></circle>
        <circle class="brand__crown" cx="16" cy="12.1" r="6.9"></circle>
        <rect class="brand__crown" x="10.6" y="14" width="10.8" height="8.1"></rect>
        <rect class="brand__trunk" x="14.6" y="21.5" width="2.8" height="3.4"></rect>
        <rect class="brand__cut" x="15.1" y="13.65" width="1.8" height="8.6"></rect>
        <rect
          class="brand__ground"
          x="0"
          y="25.3"
          width="32"
          height="1.2"
          clip-path="url(#brand-mark-disc)"
        ></rect>
      </svg>
      <span class="brand__name">
        КП УЗН
        <span>Деснянського району</span>
      </span>
    </a>

    <nav class="nav" aria-label="Розділи сайту">
      <button class="nav__toggle" type="button" popovertarget="site-nav" aria-label="Меню розділів">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>

      <ul class="nav__list" id="site-nav" popover>
        {NAV.map((item) => (
          <li>
            {isCurrent(item.path) ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={withBase(item.path)}>{item.label}</a>
            )}
            {item.children && (
              <ul class="nav__sub">
                {item.children.map((child) => (
                  <li>
                    {isCurrent(child.path) ? (
                      <span aria-current="page">{child.label}</span>
                    ) : (
                      <a href={withBase(child.path)}>{child.label}</a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
