---
/**
 * Ссылка-телефон для страниц Astro: разметку даёт React-компонент
 * `cards/PhoneLink`, общий с предпросмотром админки (решение 046).
 */
import { PhoneLink } from './cards/PhoneLink';
import { renderStatic } from './cards/render-static';

interface Props {
  /** Телефон в виде хранения +380XXXXXXXXX */
  phone: string;
  /** Часы ответа или другая подпись под номером */
  hint?: string | undefined;
}

const { phone, hint } = Astro.props;
---

<Fragment set:html={renderStatic(PhoneLink, { phone, hint })} />
