---
/**
 * Ссылка на документ «Публічної інформації» (ТЗ 4.3) для страниц Astro.
 * Адрес файла сборки находит слой gateway; разметку даёт React-компонент
 * `cards/DocLink`, общий с админкой (решение 046).
 */
import type { PublicDoc } from '@uzn/shared';
import { DocLink } from './cards/DocLink';
import { renderStatic } from './cards/render-static';
import { docTarget } from '../gateway/media';

interface Props {
  doc: PublicDoc;
  label: string;
}

const { doc, label } = Astro.props;
---

<Fragment set:html={renderStatic(DocLink, { label, target: docTarget(doc) })} />
