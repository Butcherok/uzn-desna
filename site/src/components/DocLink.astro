---
/**
 * Ссылка на документ «Публічної інформації» (ТЗ 4.3). Внешний адрес
 * открывается в новой вкладке со значком выхода; файл на этом сайте
 * (`own`, решение 042) — обычной ссылкой с типом файла и датой обновления.
 */
import { formatDate, type PublicDoc } from '@uzn/shared';
import { publicDocFile } from '../gateway/media';

interface Props {
  doc: PublicDoc;
  label: string;
}

const { doc, label } = Astro.props;
const file = doc.filePath ? publicDocFile(doc.filePath) : null;
---

{file ? (
  <>
    <a href={file.href} type={file.kind === 'PDF' ? 'application/pdf' : undefined}>
      {label}
    </a>{' '}
    <span>
      ({file.kind}
      {doc.docUpdatedAt && <>, оновлено {formatDate(doc.docUpdatedAt)}</>})
    </span>
  </>
) : (
  <a class="ext" href={doc.externalUrl} target="_blank" rel="noopener noreferrer">
    {label}
  </a>
)}
