---
/**
 * Переключатель `UA / EN` (ТЗ 3.2, п. 4 и 6; 12.4; решение 056). Обычные
 * ссылки, без JavaScript: текущий язык — текст с `aria-current`, другой —
 * ссылка с `hreflang` и `lang` на свою языковую версию страницы. У страницы
 * без перевода ссылка ведёт на английскую главную. Английской версии нет
 * вовсе — переключателя нет: ссылке некуда вести.
 *
 * Видимые буквы входят в имя ссылки («EN — English version»): так требует
 * WCAG 2.5.3 «Label in Name», и так её называют голосом.
 */
import { withBase } from '../config/site';
import { HTML_LANG, type Lang } from '../i18n/lang';
import { UI } from '../i18n/ui';
import { switchTarget } from '../i18n/availability';

interface Props {
  /** Путь страницы без языкового префикса */
  path: string;
  lang: Lang;
}

const { path, lang } = Astro.props;
const LANGS: readonly Lang[] = ['uk', 'en'];
const items = LANGS.map((code) => ({
  code,
  href: code === lang ? undefined : switchTarget(path, code),
}));
const enabled = items.every((item) => item.code === lang || item.href !== undefined);
---

{enabled && (
  <nav class="lang-switch" aria-label={UI[lang].langNav}>
    <ul class="lang-switch__list">
      {items.map((item, i) => (
        <li>
          {i > 0 && (
            <span class="lang-switch__sep" aria-hidden="true">
              /
            </span>
          )}
          {item.href === undefined ? (
            <span class="lang-switch__item" aria-current="true">
              {UI[item.code].langCode}
              <span class="vh"> — {UI[item.code].langLink}</span>
            </span>
          ) : (
            <a
              class="lang-switch__item"
              href={withBase(item.href)}
              hreflang={HTML_LANG[item.code]}
              lang={HTML_LANG[item.code]}
            >
              {UI[item.code].langCode}
              <span class="vh"> — {UI[item.code].langLink}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
