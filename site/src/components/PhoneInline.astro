---
/**
 * Телефон внутри строки текста для страниц Astro: разметку даёт
 * React-компонент `cards/PhoneInline`, общий с админкой (решение 046).
 */
import { PhoneInline } from './cards/PhoneInline';
import { renderStatic } from './cards/render-static';

interface Props {
  /** Телефон в виде хранения +380XXXXXXXXX */
  phone: string;
}

const { phone } = Astro.props;
---

<Fragment set:html={renderStatic(PhoneInline, { phone })} />
