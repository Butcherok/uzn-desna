---
/**
 * Общая оболочка публичных страниц. С версии 3 язык — параметр оболочки
 * (решение 056): `lang`, `og:locale`, канонический адрес своей версии,
 * `hreflang` uk/en/x-default (ТЗ 3.2, п. 4–6), подписи — из словаря `i18n/ui`.
 * Метаданные — ТЗ 11.4; закрытие от поисковиков — ТЗ 3.3; политика
 * содержимого — ТЗ 11.5, п. 5; доступность — ТЗ 11.3.
 */
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contacts, contentUpdatedAt, enterprise } from '../gateway/data';
import { footerContacts } from '../domain/contacts';
import { breadcrumbJsonLd, breadcrumbsFor } from '../domain/breadcrumbs';
import { INDEXING_ENABLED, NAV, OG_IMAGE_ALT, SITE_NAME, withBase } from '../config/site';
import { HTML_LANG, OG_LOCALE, localizedPath, type Lang } from '../i18n/lang';
import { UI } from '../i18n/ui';
import { hasEnglish } from '../i18n/availability';
import headFontUrl from '../fonts/fixel-display-cyrlat-var.woff2?url';
import '../styles/tokens.css';
import '../styles/components.css';

interface Props {
  /** Название раздела: совпадает с пунктом меню и с единственным h1 */
  section: string;
  /**
   * Путь страницы с завершающей косой чертой, без языкового префикса:
   * `/services/` и для украинской, и для английской версии.
   */
  path: string;
  /** Язык страницы; по умолчанию украинский (ТЗ 3.2, п. 4) */
  lang?: Lang;
  /** До появления заглушки 50 — название раздела */
  description?: string;
  /**
   * Полный `<title>` вместо формулы «Розділ — назва». Нужен главной: слово
   * «Головна» в выдаче ничего не говорит (ТЗ 11.4, решение 039).
   */
  title?: string;
  /** `false` — страница вне индекса и после снятия закрытия (ТЗ 11.4) */
  indexable?: boolean;
  /**
   * Страница ошибки: GitHub Pages отдаёт её на любой несуществующий адрес,
   * поэтому канонического адреса и `og:url` у неё нет (решение 039).
   */
  errorPage?: boolean;
  /** Разметка Schema.org, выводится как `application/ld+json` */
  jsonLd?: Record<string, unknown> | undefined;
  /**
   * Чужие адреса, к которым страница обращается из скрипта. Нужен одной
   * странице — будильнику `/admin` (решение 040): остальные не обращаются никуда.
   */
  connectSrc?: readonly string[];
}

const {
  section,
  path,
  lang = 'uk',
  description,
  title: titleOverride,
  indexable = true,
  errorPage = false,
  jsonLd,
  connectSrc = [],
} = Astro.props;

/**
 * Оболочка страницы читает данные подвала сама: подвал одинаков на всех
 * страницах, и передавать его данные через каждую страницу значило бы
 * повторять один и тот же параметр восемь раз. Чтение — слой `gateway`,
 * отбор — `domain`, вывод — `components` (ТЗ 10.2).
 */
const footer = footerContacts(contacts);

const ui = UI[lang];
const title = titleOverride ?? `${section} — ${ui.nameShort}`;
const metaDescription = description ?? `${section} — ${ui.nameShort}`;
const absolute = (p: string): string => new URL(withBase(p), Astro.site).href;
const canonical = absolute(localizedPath(path, lang));

/**
 * Связь языковых версий (ТЗ 3.2, п. 6): только у страницы, у которой есть
 * обе версии, — `uk`, `en` и `x-default` на украинскую. У страницы без
 * перевода `hreflang` нет: ссылаться не на что, а на себя — бессмысленно.
 * Английская страница без украинской не собирается (решение 056).
 */
const bilingual = !errorPage && hasEnglish(path);
const alternates = bilingual
  ? [
      { hreflang: HTML_LANG.uk, href: absolute(localizedPath(path, 'uk')) },
      { hreflang: HTML_LANG.en, href: absolute(localizedPath(path, 'en')) },
      { hreflang: 'x-default', href: absolute(localizedPath(path, 'uk')) },
    ]
  : [];
const otherLocale = bilingual ? OG_LOCALE[lang === 'uk' ? 'en' : 'uk'] : undefined;

/**
 * Одна настройка на весь сайт (ТЗ 11.4, п. 1). До снятия закрытия — запрет
 * везде; после — запрет только у страниц вне индекса, ссылки с них поисковик
 * проходит (`follow`).
 */
const robots = !INDEXING_ENABLED ? 'noindex, nofollow' : indexable ? null : 'noindex, follow';

/**
 * Навигационная цепочка — только у подпунктов меню (решение 054); вместе с
 * ней — разметка `BreadcrumbList`.
 */
const crumbs = errorPage || lang !== 'uk' ? [] : breadcrumbsFor(NAV, path);
const structured = [jsonLd, crumbs.length ? breadcrumbJsonLd(crumbs, absolute) : undefined].filter(
  (item): item is Record<string, unknown> => item !== undefined,
);

/** `<` экранируется, чтобы текст данных не закрыл тег `script` */
const jsonLdTexts = structured.map((item) => JSON.stringify(item).replace(/</g, '\\u003c'));

/**
 * Изображение для ссылки в соцсетях и мессенджерах: одно на сайт, 1200×630,
 * из дневного баннера (ТЗ 11.4; заглушка 49 закрыта решением 054). Адрес
 * абсолютный — так требует протокол Open Graph.
 */
const ogImage = absolute('/og-image.jpg');

const csp = [
  "default-src 'self'",
  "img-src 'self' data:",
  "script-src 'self'",
  "style-src 'self'",
  "font-src 'self'",
  ["connect-src 'self'", ...connectSrc].join(' '),
  "frame-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    {robots && <meta name="robots" content={robots} />}

    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {!errorPage && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {/* Значок вкладки. Адрес через withBase: корневой /favicon.ico браузера
        до страниц проекта не доходит — сайт живёт в подпапке (ТЗ 5.3, п. 10).
        Метка версии в адресе (`?v=3`): меняется при каждой правке рисунка: кэш значков Chrome держит значок дольше страницы,
        и без смены адреса браузер остаётся на прежнем файле (решение 015) */}
    <link rel="icon" href={withBase('/favicon.svg?v=3')} type="image/svg+xml" sizes="any" />
    {/* Значок при сохранении сайта на экран телефона (решение 054): iPhone
        берёт `apple-touch-icon`, Android — значки из `manifest`. Офлайна и
        установки как приложения нет: `display: browser`. */}
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {otherLocale && <meta property="og:locale:alternate" content={otherLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    {!errorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={lang === 'uk' ? SITE_NAME : ui.nameShort} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'uk' ? OG_IMAGE_ALT : ui.ogImageAlt} />
    {jsonLdTexts.map((text) => (
      <script is:inline type="application/ld+json" set:html={text} />
    ))}

    <link rel="preload" href={headFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>

  <body>
    <a class="skip" href="#main">
      {ui.skip}
    </a>
    <SiteHeader currentPath={path} lang={lang} />
    <main id="main" class="container section">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label={ui.crumbsLabel}>
          <ol>
            {crumbs.map((crumb, i) =>
              i < crumbs.length - 1 ? (
                <li>
                  <a href={withBase(crumb.path)}>{crumb.label}</a>
                </li>
              ) : (
                <li>
                  <span aria-current="page">{crumb.label}</span>
                </li>
              ),
            )}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <SiteFooter
      contacts={footer}
      email={enterprise.email}
      updatedAt={contentUpdatedAt}
      lang={lang}
    />
  </body>
</html>
