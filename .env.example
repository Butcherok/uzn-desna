# Базовый путь и адрес сайта (ТЗ 3.2 п.1). Значения не секретны.
PUBLIC_BASE_PATH=/uzn-desna
PUBLIC_SITE_ORIGIN=https://butcherok.github.io

# Версия 2. Адрес сервиса на Render для страницы /admin (решение 040); не секрет.
# По умолчанию — https://uzn-desna-api.onrender.com.
# PUBLIC_API_BASE=

# Бэкенд (server/, ТЗ 10.5). Только имена — значения задаются в настройках Render.
# Локально для `npm run dev --workspace server` их можно положить в server/.env (он в .gitignore).
# NODE_ENV=production
# PORT=
# MONGODB_URI=
# MONGODB_DB=uzn
# SITE_ORIGIN=https://butcherok.github.io
# COOKIE_SAME_SITE=lax
# TRUST_PROXY=0                  # на Render — 1 (render.yaml, решение 037)
# RENDER_EXTERNAL_URL=           # Render задаёт сам; свой адрес для Origin админки (решение 040)
# ADMIN_DIST_DIR=                # каталог сборки админки; по умолчанию admin/dist
# BOOTSTRAP_OWNER_LOGIN=
# BOOTSTRAP_OWNER_PASSWORD_HASH=   # хэш из `npm run hash-password`, не пароль
# BOOTSTRAP_OWNER_DISPLAY_NAME=
# Публикация (ТЗ 8.5, решение 041). Токен GitHub: fine-grained, только этот
# репозиторий, Actions: Read and write. EXPORT_TOKEN — тот же, что секрет Actions.
# GITHUB_DISPATCH_TOKEN=
# EXPORT_TOKEN=                  # не меньше 32 знаков
# GITHUB_REPOSITORY=Butcherok/uzn-desna
# PUBLISH_WORKFLOW=publish-content.yml
# PUBLISH_REF=main
