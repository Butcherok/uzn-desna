{
  "name": "@uzn/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API бэкенда версии 2 (ТЗ 8): Fastify, MongoDB, вход и сессии.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --sourcemap --external:fastify --external:@fastify/* --external:mongodb --external:bcryptjs --external:zod",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts",
    "hash-password": "tsx src/bin/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@uzn/shared": "*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "mongodb": "^7.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
